{
  "$id": "countries",
  "type": "object",
  "required": ["schema", "version", "items"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "countries" },
    "version": { "type": "integer", "minimum": 1 },
    "_note": { "type": "string" },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/country" } }
  },
  "definitions": {
    "country": {
      "type": "object",
      "required": ["id", "name", "adjective", "theater", "capital", "government", "aiTier", "population", "start"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "name": { "$ref": "common#/definitions/text" },
        "adjective": { "$ref": "common#/definitions/text" },
        "theater": { "$ref": "common#/definitions/id" },
        "capital": {
          "type": "object",
          "required": ["name", "region"],
          "additionalProperties": false,
          "properties": {
            "name": { "$ref": "common#/definitions/text" },
            "region": { "type": "string", "pattern": "^[A-Z]{3}-[a-z][a-z0-9_]*$" }
          }
        },
        "government": { "$ref": "common#/definitions/id" },
        "aiTier": { "enum": [1, 2, 3] },
        "traits": { "type": "array", "items": { "$ref": "common#/definitions/id" } },
        "population": { "type": "integer", "minimum": 1 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "start": {
          "type": "object",
          "required": ["economy", "budget"],
          "additionalProperties": false,
          "properties": {
            "budget": {
              "type": "object",
              "required": ["military", "research", "welfare", "infrastructure"],
              "additionalProperties": false,
              "properties": {
                "military": { "$ref": "common#/definitions/fraction" },
                "research": { "$ref": "common#/definitions/fraction" },
                "welfare": { "$ref": "common#/definitions/fraction" },
                "infrastructure": { "$ref": "common#/definitions/fraction" }
              }
            },
            "resources": {
              "type": "object",
              "required": ["production", "consumption", "stockpile"],
              "additionalProperties": false,
              "properties": {
                "production": { "$ref": "#/definitions/perResource" },
                "consumption": { "$ref": "#/definitions/perResource" },
                "stockpile": { "$ref": "#/definitions/perResource" },
                "stateShare": { "type": "object", "additionalProperties": { "$ref": "common#/definitions/fraction" } }
              }
            },
            "economy": {
              "type": "object",
              "required": ["gdpBn", "growth", "taxRate", "debtPctGdp", "treasuryMn"],
              "additionalProperties": false,
              "properties": {
                "gdpBn": { "type": "number", "exclusiveMinimum": 0 },
                "growth": { "type": "number", "minimum": -0.5, "maximum": 0.5 },
                "taxRate": { "$ref": "common#/definitions/fraction" },
                "debtPctGdp": { "type": "number", "minimum": 0 },
                "inflation": { "type": "number", "minimum": -0.5 },
                "treasuryMn": { "type": "number", "minimum": 0 }
              }
            }
          }
        },
        "chokepoints": { "type": "object", "additionalProperties": { "$ref": "common#/definitions/fraction" } },
        "sources": { "type": "object", "additionalProperties": { "type": "string" } },
        "note": { "type": "string" }
      }
    },
    "perResource": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }
  }
}
