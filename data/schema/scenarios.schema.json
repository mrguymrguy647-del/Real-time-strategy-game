{
  "$id": "scenarios",
  "type": "object",
  "required": ["schema", "version", "items"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "scenarios" },
    "version": { "type": "integer", "minimum": 1 },
    "_note": { "type": "string" },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/scenario" } }
  },
  "definitions": {
    "scenario": {
      "type": "object",
      "required": ["id", "name", "blurb", "startDate", "worldMode", "theaters", "playable", "offMap", "goal", "overrides"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common#/definitions/id" },
        "name": { "$ref": "common#/definitions/text" },
        "blurb": { "$ref": "common#/definitions/text" },
        "startDate": { "type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$" },
        "worldMode": { "enum": ["real", "random"] },
        "theaters": { "type": "array", "items": { "$ref": "common#/definitions/id" } },
        "playable": { "oneOf": [{ "type": "null" }, { "type": "array", "items": { "type": "string" } }] },
        "offMap": {
          "type": "object",
          "required": ["patrons"],
          "additionalProperties": false,
          "properties": {
            "patrons": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "name"],
                "additionalProperties": false,
                "properties": {
                  "id": { "$ref": "common#/definitions/id" },
                  "name": { "$ref": "common#/definitions/text" }
                }
              }
            }
          }
        },
        "goal": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["type"],
              "additionalProperties": false,
              "properties": {
                "type": { "enum": ["regional_power"] },
                "years": { "type": "integer", "minimum": 1, "maximum": 100 }
              }
            }
          ]
        },
        "overrides": { "type": "object" },
        "_note": { "type": "string" }
      }
    }
  }
}
